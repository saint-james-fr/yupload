    "@tauri-apps/plugin-opener": "2.5.3",
    "@tauri-apps/plugin-store": "2.4.2",
    "@vueuse/components": "14.1.0",
    "@vueuse/core": "14.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-vue-next": "0.563.0",
    "tailwind-merge": "3.4.0",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
